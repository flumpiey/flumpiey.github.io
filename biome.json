{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"includes": [
			"**",
			"!**/node_modules/**",
			"!**/build/**",
			"!**/.svelte-kit/**",
			"!**/static/**",
			"!**/*.svelte"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		},
		"includes": [
			"**",
			"!**/node_modules/**",
			"!**/build/**",
			"!**/.svelte-kit/**",
			"!**/*.svelte"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"formatter": { "enabled": false },
			"linter": { "enabled": false }
		}
	]
}
